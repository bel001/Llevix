# Llevix: planificador de E/S según el tipo de disco.
# Discos giratorios (HDD, y muchas memorias USB que se declaran así): bfq, más fluido.
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
# SSD por SATA/USB: mq-deadline.
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
# NVMe: sin planificador (el propio disco ordena las peticiones).
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/scheduler}="none"
# Discos conectados por USB (memorias, discos y SSD externos): siempre bfq, aunque se
# declaren no giratorios. bfq da prioridad a lo que el usuario abre sobre las tareas de
# fondo (las actualizaciones tienen prioridad de disco baja: ver
# /etc/systemd/system/*.service.d/llevix-prioridad-baja.conf).
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd[a-z]*", SUBSYSTEMS=="usb", ATTR{queue/scheduler}="bfq"
