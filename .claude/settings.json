{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git *)",
      "Bash(gh run *)",
      "Bash(gh pr *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(gh issue *)",
      "Bash(./tools/*)",
      "Bash(./tests/*)",
      "Bash(bash tools/*)",
      "Bash(bash tests/*)",
      "Bash(shellcheck *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(chmod +x *)",
      "Bash(sha256sum *)",
      "Bash(zstd *)",
      "Bash(jq *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(cargo *)",
      "Bash(rustc *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(sudo dd *)",
      "Bash(dd *)",
      "Bash(sudo wipefs *)",
      "Bash(sudo rm -rf /*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
